///////--------------------------------- Linear Search ---------------------------------////////

#include <iostream>
using namespace std;

int linsearch(int arr[], int n, int tar);

int main() {
    int n;
    cout << "Enter the size of the array: ";
    cin >> n;

    int arr[n];
    cout << "Enter " << n << " elements : ";
    for(int i = 0; i < n; i++) {
        cin >> arr[i];
    }

    int tar;
    cout << "Enter the element to search: ";
    cin >> tar;

    int res = linsearch(arr, n, tar);
    if(res != -1)
        cout << "Element is found at index " << res;
    else
        cout << "Element is not found";
        
    return 0;
}

int linsearch(int arr[], int n, int tar) {
    for(int i = 0; i < n; i++) {
        if(arr[i] == tar) {
            return i;
        }
    }
    return -1; 
}



///////----------------------------------------- Binary Search ----------------------------------------///////

#include <iostream>
using namespace std;

int binsearch(int arr[], int n, int tar) {
    int l = 0;
    int r = n - 1;
    
    while(l <= r) {
        int mid = (l + r) / 2;
        
        if(arr[mid] == tar) {
            return mid;
        }
        if(arr[mid] < tar) {
            l = mid + 1;
        }
        else {
            r = mid - 1;
        }
    }
    return -1;
}

int main() {
    int n;
    cout << "Enter the size of the array: ";
    cin >> n;

    int* arr = new int[n];

    cout << "Enter " << n << " SORTED elements: ";
    for(int i = 0; i < n; i++) {
        cin >> arr[i];
    }

    int tar;
    cout << "Enter the element to search: ";
    cin >> tar;

    int res = binsearch(arr, n, tar);
    
    if(res != -1) {
        cout << "Element is found at index " << res << endl;
    }
    else {
        cout << "Element is not found" << endl;
    }

    delete[] arr;
        
    return 0;
}
